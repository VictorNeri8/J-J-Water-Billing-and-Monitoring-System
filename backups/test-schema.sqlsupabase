);


ALTER TABLE "public"."admin_profiles" OWNER TO "postgres";


CREATE TABLE IF NOT EXISTS "public"."billings" (
    "id" "uuid" DEFAULT "gen_random_uuid"() NOT NULL,
    "customer_id" "uuid" NOT NULL,
    "meter_reading_id" "uuid" NOT NULL,
    "usage_cubic" numeric(10,2) NOT NULL,
    "amount" numeric(10,2) NOT NULL,
    "billing_date" "date" DEFAULT CURRENT_DATE NOT NULL,
    "due_date" "date" NOT NULL,
    "status" "text" DEFAULT 'unpaid'::"text" NOT NULL,
    "paid_date" "date",
    "updated_by" "uuid",
    "created_at" timestamp with time zone DEFAULT "now"(),
    "updated_at" timestamp with time zone DEFAULT "now"(),
    "amount_paid" numeric(10,2) DEFAULT 0 NOT NULL,
    "payment_method" "text",
    CONSTRAINT "billings_payment_method_check" CHECK ((("payment_method" IS NULL) OR ("payment_method" = ANY (ARRAY['cash'::"text", 'online'::"text"])))),
    CONSTRAINT "billings_status_check" CHECK (("status" = ANY (ARRAY['paid'::"text", 'partial'::"text", 'unpaid'::"text", 'overdue'::"text"])))
);


ALTER TABLE "public"."billings" OWNER TO "postgres";


