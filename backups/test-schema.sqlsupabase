


SET statement_timeout = 0;
SET lock_timeout = 0;
SET idle_in_transaction_session_timeout = 0;
SET client_encoding = 'UTF8';
SET standard_conforming_strings = on;
SELECT pg_catalog.set_config('search_path', '', false);
SET check_function_bodies = false;
SET xmloption = content;
SET client_min_messages = warning;
SET row_security = off;


CREATE SCHEMA IF NOT EXISTS "public";


ALTER SCHEMA "public" OWNER TO "pg_database_owner";


COMMENT ON SCHEMA "public" IS 'standard public schema';



CREATE OR REPLACE FUNCTION "public"."analytics_billing_status_count"("p_start_date" "date" DEFAULT NULL::"date") RETURNS TABLE("status" "text", "value" bigint)
    LANGUAGE "sql" STABLE
    AS $$
  WITH ranked_billings AS (
    SELECT
      customer_id,
      status,
      billing_date,
      created_at,
      ROW_NUMBER() OVER (
        PARTITION BY customer_id
        ORDER BY billing_date DESC, created_at DESC
      ) AS row_num
    FROM public.billings
    WHERE p_start_date IS NULL OR billing_date >= p_start_date
  )
  SELECT
    status,
    COUNT(*) AS value
  FROM ranked_billings
  WHERE row_num = 1
  GROUP BY status
  ORDER BY status ASC;
$$;


ALTER FUNCTION "public"."analytics_billing_status_count"("p_start_date" "date") OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."analytics_monthly_revenue"("p_start_date" "date" DEFAULT NULL::"date") RETURNS TABLE("month" "text", "total_revenue" numeric)
    LANGUAGE "sql" STABLE
    AS $$
  SELECT
    TO_CHAR(DATE_TRUNC('month', billing_date), 'Mon') AS month,
    COALESCE(SUM(amount), 0) AS total_revenue
  FROM public.billings
  WHERE status = 'paid'
    AND (p_start_date IS NULL OR billing_date >= p_start_date)
  GROUP BY DATE_TRUNC('month', billing_date)
  ORDER BY DATE_TRUNC('month', billing_date) ASC;
$$;


ALTER FUNCTION "public"."analytics_monthly_revenue"("p_start_date" "date") OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."analytics_monthly_water_usage"("p_start_date" "date" DEFAULT NULL::"date") RETURNS TABLE("month" "text", "total_usage" numeric)
    LANGUAGE "sql" STABLE
    AS $$
  SELECT
    TO_CHAR(DATE_TRUNC('month', billing_date), 'Mon') AS month,
    COALESCE(SUM(usage_cubic), 0) AS total_usage
  FROM public.billings
  WHERE p_start_date IS NULL OR billing_date >= p_start_date
  GROUP BY DATE_TRUNC('month', billing_date)
  ORDER BY DATE_TRUNC('month', billing_date) ASC;
$$;


ALTER FUNCTION "public"."analytics_monthly_water_usage"("p_start_date" "date") OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."analytics_revenue"("p_start_date" "date" DEFAULT NULL::"date", "p_bucket" "text" DEFAULT 'month'::"text", "p_status" "text" DEFAULT 'paid'::"text") RETURNS TABLE("bucket_date" "date", "total_revenue" numeric)
    LANGUAGE "sql" STABLE
    AS $$
  WITH paid_snapshots AS (
    SELECT
      customer_id,
      paid_date AS event_date,
      MAX(COALESCE(amount_paid, amount)) AS revenue_value
    FROM public.billings
    WHERE p_status = 'paid'
      AND status = 'paid'
      AND paid_date IS NOT NULL
      AND (p_start_date IS NULL OR paid_date >= p_start_date)
    GROUP BY customer_id, paid_date
  ),
  partial_snapshots AS (
    SELECT
      customer_id,
      billing_date AS event_date,
      COALESCE(amount_paid, 0) AS revenue_value,
      ROW_NUMBER() OVER (
        PARTITION BY customer_id
        ORDER BY billing_date DESC, created_at DESC
      ) AS row_num
    FROM public.billings
    WHERE p_status = 'partial'
      AND status = 'partial'
      AND COALESCE(amount_paid, 0) > 0
      AND (p_start_date IS NULL OR billing_date >= p_start_date)
  ),
  selected_rows AS (
    SELECT event_date, revenue_value
    FROM paid_snapshots
    WHERE p_status = 'paid'

    UNION ALL

    SELECT event_date, revenue_value
    FROM partial_snapshots
    WHERE p_status = 'partial' AND row_num = 1
  )
  SELECT
    CASE
      WHEN p_bucket = 'day' THEN event_date
      ELSE DATE_TRUNC('month', event_date)::DATE
    END AS bucket_date,
    COALESCE(SUM(revenue_value), 0) AS total_revenue
  FROM selected_rows
  GROUP BY 1
  ORDER BY 1 ASC;
$$;


ALTER FUNCTION "public"."analytics_revenue"("p_start_date" "date", "p_bucket" "text", "p_status" "text") OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."analytics_water_usage"("p_start_date" "date" DEFAULT NULL::"date", "p_bucket" "text" DEFAULT 'month'::"text") RETURNS TABLE("bucket_date" "date", "total_usage" numeric)
    LANGUAGE "sql" STABLE
    AS $$
  SELECT
    CASE
      WHEN p_bucket = 'day' THEN reading_date
      ELSE DATE_TRUNC('month', reading_date)::DATE
    END AS bucket_date,
    COALESCE(SUM(usage_cubic), 0) AS total_usage
  FROM public.meter_readings
  WHERE p_start_date IS NULL OR reading_date >= p_start_date
  GROUP BY 1
  ORDER BY 1 ASC;
$$;


ALTER FUNCTION "public"."analytics_water_usage"("p_start_date" "date", "p_bucket" "text") OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."enforce_admin_profile_limits"() RETURNS "trigger"
    LANGUAGE "plpgsql"
    AS $$
BEGIN
  IF TG_OP = 'DELETE' THEN
    RAISE EXCEPTION 'Admin profiles cannot be deleted; one finance and one reader profile are required.';
  END IF;

  IF (
    SELECT COUNT(*)
    FROM public.admin_profiles
    WHERE id <> COALESCE(NEW.id, '00000000-0000-0000-0000-000000000000'::uuid)
  ) >= 2 THEN
    RAISE EXCEPTION 'Only two admin profiles are allowed.';
  END IF;

  RETURN NEW;
END;
$$;


ALTER FUNCTION "public"."enforce_admin_profile_limits"() OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."generate_account_number"() RETURNS "text"
    LANGUAGE "plpgsql"
    AS $$
DECLARE
  new_number TEXT;
  year_part TEXT;
  seq_number INTEGER;
BEGIN
  year_part := TO_CHAR(NOW(), 'YYYY');
  SELECT COALESCE(MAX(CAST(SUBSTRING(account_number FROM 6) AS INTEGER)), 0) + 1
  INTO seq_number
  FROM public.customers
  WHERE account_number LIKE year_part || '-%';
  
  new_number := year_part || '-' || LPAD(seq_number::TEXT, 5, '0');
  RETURN new_number;
END;
$$;


ALTER FUNCTION "public"."generate_account_number"() OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."update_updated_at_column"() RETURNS "trigger"
    LANGUAGE "plpgsql"
    AS $$
BEGIN
  NEW.updated_at = NOW();
  RETURN NEW;
END;
$$;


ALTER FUNCTION "public"."update_updated_at_column"() OWNER TO "postgres";

