CREATE OR REPLACE VIEW "public"."stub_out_location_summaries" AS
SELECT
    NULL::"uuid" AS "id",
    NULL::"text" AS "code",
    NULL::"text" AS "name",
    NULL::"text" AS "municipality",
    NULL::"text" AS "barangay",
    NULL::"text" AS "sitio",
    NULL::"text" AS "purok",
    NULL::numeric AS "latitude",
    NULL::numeric AS "longitude",
    NULL::"text" AS "status",
    NULL::"text" AS "notes",
    NULL::timestamp with time zone AS "created_at",
    NULL::timestamp with time zone AS "updated_at",
    NULL::integer AS "assigned_customer_count",
    NULL::"uuid" AS "created_by_user_id",
    NULL::"text" AS "created_by_email",
    NULL::"text" AS "created_by_role";


ALTER VIEW "public"."stub_out_location_summaries" OWNER TO "postgres";


CREATE TABLE IF NOT EXISTS "public"."stub_out_locations" (
    "id" "uuid" DEFAULT "gen_random_uuid"() NOT NULL,
    "code" "text" NOT NULL,
    "name" "text",
    "municipality" "text" NOT NULL,
    "barangay" "text" NOT NULL,
    "sitio" "text",
    "purok" "text",
    "latitude" numeric NOT NULL,
    "longitude" numeric NOT NULL,
    "status" "text" DEFAULT 'active'::"text" NOT NULL,
    "notes" "text",
    "created_at" timestamp with time zone DEFAULT "now"(),
    "updated_at" timestamp with time zone DEFAULT "now"(),
    "created_by_user_id" "uuid",
    "created_by_email" "text",
    "created_by_role" "text",
    CONSTRAINT "stub_out_locations_latitude_check" CHECK ((("latitude" >= ('-90'::integer)::numeric) AND ("latitude" <= (90)::numeric))),
    CONSTRAINT "stub_out_locations_longitude_check" CHECK ((("longitude" >= ('-180'::integer)::numeric) AND ("longitude" <= (180)::numeric))),
    CONSTRAINT "stub_out_locations_municipality_check" CHECK (("municipality" = ANY (ARRAY['Consolacion'::"text", 'Liloan'::"text"]))),
    CONSTRAINT "stub_out_locations_status_check" CHECK (("status" = ANY (ARRAY['active'::"text", 'inactive'::"text"])))
);


ALTER TABLE "public"."stub_out_locations" OWNER TO "postgres";


